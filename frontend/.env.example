# Base URL of the Django REST API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Display currency for prices returned by the API (which are plain decimals
# with no currency attached). Any ISO 4217 code Intl.NumberFormat supports.
VITE_CURRENCY_CODE=BDT
VITE_CURRENCY_LOCALE=en-BD

# Shown in the header, footer, and browser tab title.
VITE_APP_NAME=ShopNest
